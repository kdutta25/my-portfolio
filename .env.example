# Same-origin: Vite (and GitHub Pages) serve generated public/v1 JSON.
# Run `npm run generate:static-content` (or npm start / npm run build) with
# my-portfolio-api/data available (CONTENT_DATA_DIR or ../my-portfolio-api/data).
# Optional: point at a live Express API instead, e.g. http://localhost:3001
VITE_CONTENT_API_BASE_URL=http://localhost:4044

# Optional: GitHub Project Pages subpath only (e.g. /my-portfolio/). Custom domain at root: omit.
# VITE_BASE_PATH=/my-portfolio/

# Legacy: full URL to GET /v1/site-content — only the origin is used if VITE_CONTENT_API_BASE_URL is unset.
# VITE_SITE_CONTENT_URL=http://localhost:4044/v1/site-content

# Production (npm run build / GitHub Pages): same host as the SPA; /v1 is baked into dist.
# VITE_CONTENT_API_BASE_URL=https://www.kaustubhdutta.com
# VITE_ALLOW_SAME_ORIGIN_CONTENT_API=true

# Dev only (npm start): if shell/.env.local sets the bare production URL, Vite uses that unless you unset it.
# The app then falls back to localhost:4044; override with:
# VITE_DEV_DEFAULT_CONTENT_API_BASE=http://127.0.0.1:4044
# Or keep production as API base in dev: VITE_DEV_ALLOW_BARE_PORTFOLIO_ORIGIN_API=true
